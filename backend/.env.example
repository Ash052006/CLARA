# ---------------------------------------------------------------------------
# CLARA backend environment variables
# Copy to backend/.env for local development. Never commit the real file.
# ---------------------------------------------------------------------------

# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins.
# For Netlify use: https://your-site.netlify.app
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Single-user authentication (required in production)
# ---------------------------------------------------------------------------
AUTH_ENABLED=true

# Generate with: python backend/scripts/hash_password.py
# Never paste the plaintext password here.
OWNER_PASSWORD_HASH=replace-with-bcrypt-hash

# Generate a long random value, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-long-random-secret

AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7

# Demo mode: blocks email sending, email replies, and calendar writes.
# Read-only email/calendar operations remain available.
DEMO_MODE=false

# Rate limiting (in-process, suitable for a single Render instance)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# AI
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=2

# Intent model (disabled by default to reduce Render memory usage)
INTENT_CLASSIFIER_ENABLED=false
INTENT_MODEL=valhalla/distilbart-mnli-12-3

# Voice / Whisper (disabled by default for Render free tier)
VOICE_ENABLED=false
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# API docs (auto-disabled in production)
ENABLE_DOCS=true

# Persistent memory
# Leave DATABASE_URL empty to keep using backend/storage/memory.json.
# Render PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/clara
DATABASE_URL=
MEMORY_BACKEND=auto
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Memory file paths (used when DATABASE_URL is empty)
STORAGE_DIR=
MEMORY_FILE=

# Google OAuth (never expose these to the frontend)
# Option A: file paths (local development)
GOOGLE_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=
GOOGLE_CALENDAR_TOKEN_FILE=
# Option B: inline JSON (recommended on Render)
GOOGLE_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=
GOOGLE_CALENDAR_TOKEN_JSON=
# Interactive browser login only works locally. Set false on Render.
GOOGLE_OAUTH_INTERACTIVE=true

# Warm up heavy models during startup (not recommended on small Render plans)
CLARA_WARMUP=false
